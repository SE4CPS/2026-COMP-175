[Unit]
Description=Team 5 Clinical Web Interface
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/2026-COMP-175/project/part-2/team5
EnvironmentFile=%h/.config/team5-web.env
ExecStart=%h/2026-COMP-175/project/part-2/team5/.venv/bin/python -m flask --app app:create_app run --host=0.0.0.0 --port=5000
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes

[Install]
WantedBy=default.target
